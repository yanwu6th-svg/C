vector<vector<int>> p;$$$
vector<vector<int>> ans;
vector<int> cnt;

void F(vector<int> no,set<int> tt,int curr_m,int curr_r,int time){
    if(time == 2)
    {
        F(no,tt,curr_m+1,0,0);
        return;
    }
    if(no.size() == k)
    {
        ans.push_back(no);
        return;
    }

    for(int i=curr_m;i<nums.size();i++){
            int w = (i==curr_m)?curr_r:0;
        for(int j=w;j<nums[i].size();j++){
            if(cnt[i] == 2) continue;
            if(tt.count(nums[i][j])) continue;

            tt.insert(nums[i][j]);
            no.push_back(p[i][j]);
            cnt[i]++;
            F(no,tt,i,j+1,time);
            cnt[i]--;
            no.pop_back();
            tt.erase(nums[i][j]);
        }
    }
    return;
}

